# Firebase client
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# sem STORAGE_BUCKET no client — quem grava e le o bucket é só o server

# Firebase Admin (server) — a private key vai com \n escapado, entre aspas duplas
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Bucket do Storage, para o upload de imagens/vídeos das landing pages.
# É o "Referência do bucket" do console, sem o gs:// (ex.: e-nova-tools.firebasestorage.app).
# Sem esta variável a ferramenta funciona; só o botão de enviar arquivo falha com
# aviso. Server-only, NUNCA com prefixo NEXT_PUBLIC.
FIREBASE_STORAGE_BUCKET=

# Server-only — NUNCA com prefixo NEXT_PUBLIC
GOOGLE_MAPS_API_KEY=

# IA do Acompanhamento de Ads — Gemini 2.5 Flash (AI Studio). Sem esta chave a
# ferramenta funciona, só o painel de IA fica desativado com aviso.
# Grátis em https://aistudio.google.com/apikey — ver ressalva de privacidade no
# free tier. Server-only, NUNCA com prefixo NEXT_PUBLIC.
GEMINI_API_KEY=

# IA do Criador de Landing Pages. Dois provedores intercambiáveis:
# - GROQ_API_KEY: Llama 3.3 70B via Groq (padrão, gratuito, sem cartão).
#   Chave grátis em https://console.groq.com/keys
# - GEMINI_API_KEY (acima): reaproveitada como alternativa.
# IA_PROVIDER escolhe qual usar: 'groq' ou 'gemini'. Em branco, usa o que tiver
# chave, preferindo o Groq. Para voltar ao Gemini, ponha IA_PROVIDER=gemini.
# Sem nenhuma chave, a página é gerada só a partir do briefing (sem IA).
# Server-only, NUNCA com prefixo NEXT_PUBLIC.
GROQ_API_KEY=
IA_PROVIDER=groq

# Busca de imagens/vídeos do Criador de Landing Pages. As fontes são somadas na
# mesma busca: quanto mais chaves, mais variedade. Sem NENHUMA delas a
# ferramenta funciona, só que as mídias ficam como espaço reservado até você
# trocar cada uma no editor. Todas server-only, NUNCA com prefixo NEXT_PUBLIC.
#
# PEXELS_API_KEY (principal, recomendada) — fotos e vídeos em alta resolução,
# sem marca d'água, uso comercial liberado. Grátis, sem cartão, em
# https://www.pexels.com/api/new/ — limite de 200 req/h e 20.000/mês.
PEXELS_API_KEY=
#
# PIXABAY_API_KEY (complementar) — soma mais acervo a cada busca. Grátis em
# https://pixabay.com/api/docs/ (a chave aparece na própria página, logado).
# Limite de 100 req/min.
PIXABAY_API_KEY=
#
# ENVATO_TOKEN (opcional, legado) — funciona como RESERVA: só é consultado se
# nenhuma das chaves acima existir. O acervo do PhotoDune é pequeno e as URLs
# são PRÉVIAS com marca d'água em baixa resolução, então ele sai de cena sozinho
# assim que você põe uma PEXELS_API_KEY. https://build.envato.com/create-token/
# Permissões necessárias: "View and search Envato sites".
ENVATO_TOKEN=

# E-mail do 2FA via Gmail SMTP. GMAIL_APP_PASSWORD = senha de app de 16 chars
# (Conta Google → Segurança → Verificação em duas etapas → Senhas de app).
GMAIL_USER=
GMAIL_APP_PASSWORD=

DEFAULT_TEAM_ID=trinca

# Google Ads API (Fase 2 — API oficial). Deixe COMENTADO até ter cada valor;
# a ferramenta de Ads roda por CSV sem isto. Todos server-only, NUNCA NEXT_PUBLIC.
# - DEVELOPER_TOKEN: API Center da conta Manager (secreto).
# - CLIENT_ID / CLIENT_SECRET: OAuth Client (Web) no Google Cloud.
# - LOGIN_CUSTOMER_ID: ID da conta Manager, só dígitos (ex.: 0000000000).
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
